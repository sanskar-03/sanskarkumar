DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,.vercel.app
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,https://*.vercel.app
# Production: paste your Neon PostgreSQL connection string here.
DATABASE_URL=
# Only needed when you want profile/project image uploads to persist on Vercel.
CLOUDINARY_URL=
FORCE_HTTPS=0
